    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "demo_datadefinition: main_simple_json.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo_datadefinition/linux/main_simple_json.py",
            "args": [],
            "jinja": true
        },
        {
            "name": "mallow uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app_emw.appweb.main_appweb_mallow:app",
                "--reload",
            ],
            "env": {
                "ENV_NEXUS_URL": "ws://192.168.1.57:8001/observer_push"
            },
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "mallow",
            "type": "debugpy",
            "request": "launch",
            "module": "app_emw.appweb.main_appweb_mallow",
            "args": [],
            "env": {},
            "jinja": true,
            "justMyCode": false
        },
        {
            "name": "nexus",
            "type": "debugpy",
            "request": "launch",
            "module": "app_emw.appweb.main_appweb_nexus",
            "args": [],
            "env": {},
            "jinja": true,
            "justMyCode": false
        },
    ]
}