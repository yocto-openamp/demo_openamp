/*
This overlay is based on:
hmp_mcuxpresso-zephyr/sources/rpmsg-lite/zephyr/samples/rpmsglite_pingpong/remote/boards/mimxrt1160_evk_mimxrt1166_cm4.overlay
hmp_mcuxpresso-zephyr/zephyr/samples/subsys/ipc/openamp_rsc_table/boards/imx8mp_evk_mimx8ml8_m7.overlay
*/

#include <zephyr/dt-bindings/sensor/icm45686.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zephyr,ipc_shm = &shram;
        zephyr,ipc = &mailbox0;
		zephyr,ipc_rsc_table = &rsc_table;
		zephyr,console = &uart4;
    };

    shram: memory@55000000 {
        compatible = "mmio-sram";
        reg = <0x55000000 0x500000>;
    };

	rsc_table: memory@550ff000 {
		compatible = "mmio-sram";
		reg = <0x550ff000 0x1000>;
	};
};

&pinctrl {
    ecspi1_default: ecspi1_default {
        group0 {
            drive-strength = "x1";
            pinmux = <&iomuxc_ecspi1_sclk_ecspi_sclk_ecspi1_sclk>,
                     <&iomuxc_ecspi1_miso_ecspi_miso_ecspi1_miso>,
                     <&iomuxc_ecspi1_mosi_ecspi_mosi_ecspi1_mosi>;
            slew-rate = "slow";
        };
    };
};

&mailbox0 {
    status = "okay";
};

&uart4 {
	status = "okay";
	current-speed = <115200>;
};

&ecspi1 {
    status = "okay";
    pinctrl-0 = <&ecspi1_default>;
    pinctrl-names = "default";
    /* Hold CS across the driver's separate address/data bursts. */
    cs-gpios = <&gpio5 9 GPIO_ACTIVE_LOW>;

    icm45686: icm45686@0 {
        compatible = "invensense,icm45686";
        reg = <0>;
        spi-max-frequency = <1000000>;
        accel-pwr-mode = <ICM45686_DT_ACCEL_LN>;
        accel-fs = <ICM45686_DT_ACCEL_FS_4>;
        accel-odr = <ICM45686_DT_ACCEL_ODR_100>;
        gyro-pwr-mode = <ICM45686_DT_GYRO_LN>;
        gyro-fs = <ICM45686_DT_GYRO_FS_2000>;
        gyro-odr = <ICM45686_DT_GYRO_ODR_100>;
        status = "okay";
    };

};

&gpio5 {
    status = "okay";
};
